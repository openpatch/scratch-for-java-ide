<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.openpatch.scratch4j</groupId>
    <artifactId>scratch4j-ide</artifactId>
    <version>0.1.0-alpha.27</version>
  </parent>

  <artifactId>core</artifactId>
  <name>Scratch for Java Studio :: core</name>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>src/test/resources</directory><includes><include>lint/snippets/corpus.json</include></includes></resource>
    </resources>
  </build>

  <dependencies>
    <!-- Local project versions use Git without requiring a Git installation. -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>7.8.0.202609011348-r</version>
    </dependency>
    <!-- Offline adapter for portable browser @Test classes and the Studio test runner. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>1.11.4</version>
    </dependency>
    <!-- Pinned library: asset registries (internal package, guarded by a
         contract test) and the runtime model of student projects; the core and
         every first-party extension, as the fat jar in +libs holds them. -->
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-desktop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-tiled</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-save</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-recorder</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-drawing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-gamepad</artifactId>
    </dependency>
    <!-- Studio's own JSON (settings, lessons, reports). Scratch for Java 6 brought Jackson along;
         7's core has none (only its save and tiled extensions use it). Same versions as the library. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.2.3</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.22</version>
    </dependency>
    <!-- The library's sources jars (core and every extension) drive the API index
         generation (ApiIndexGenerator + parity test). -->
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-tiled</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-save</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-recorder</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-drawing</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openpatch</groupId>
      <artifactId>scratch-gamepad</artifactId>
      <version>${scratch.version}</version>
      <classifier>sources</classifier>
      <scope>test</scope>
    </dependency>
    <!-- SVG costumes (Scratch 3 vector costumes, SVG import in the paint
         editor) are rasterized with Batik - pure Java, no JavaFX. -->
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-transcoder</artifactId>
      <version>1.17</version>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-codec</artifactId>
      <version>1.17</version>
    </dependency>
  </dependencies>
</project>
